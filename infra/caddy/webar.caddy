# El bloque de Labtory (antes WebAR) en el Caddy de Peer4U (contenedor sanatorio-caddy-1).
# deploy.sh lo copia a /opt/caddy-sitios/webar.caddy, lo valida y recarga
# Caddy; si no valida, deja el de antes. Un error aquí podría tumbar Peer4U en
# el siguiente arranque de Caddy: valida siempre antes de recargar.
labtory.peer4u.app {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# La realidad aumentada necesita cámara y sensores de esta misma web.
		Permissions-Policy "camera=(self), microphone=(), geolocation=(self), accelerometer=(self), gyroscope=(self), magnetometer=(self), xr-spatial-tracking=(self), payment=()"
		-Server
		-Via
	}

	# `webar` es el alias del contenedor en la red sanatorio_default.
	reverse_proxy webar:8080 {
		health_uri /health
		health_interval 30s
		header_down -Via
	}
}

# El dominio de antes: los enlaces, QR y tarjetas impresas siguen funcionando.
# La app instalada desde aquí tiene un service worker que sirve su copia y,
# para actualizarse, pide /sw.js: una redirección no le vale (se quedaría en
# la versión vieja para siempre). Por eso /sw.js devuelve uno que borra su
# caché, se da de baja y lleva cada ventana a labtory.peer4u.app.
webar.peer4u.app {
	handle /sw.js {
		header Content-Type "text/javascript; charset=utf-8"
		header Cache-Control "no-cache"
		respond `self.addEventListener('install', () => self.skipWaiting());
self.addEventListener('activate', (event) => event.waitUntil((async () => {
  for (const key of await caches.keys()) await caches.delete(key);
  await self.registration.unregister();
  for (const client of await self.clients.matchAll({ type: 'window' })) {
    const url = new URL(client.url);
    client.navigate('https://labtory.peer4u.app' + url.pathname + url.search);
  }
})()));` 200
	}
	handle {
		redir https://labtory.peer4u.app{uri} permanent
	}
}
